def phishing_model(text):
    text = text.lower()
    
    phishing_keywords = ["win", "bank", "urgent", "verify", "money", "prize"]
    score = sum(1 for word in phishing_keywords if word in text)
    
    if score > 0:
        return "Phishing"
    else:
        return "Safe"

print("--- Phishing Detection Model ---")
email = input("Enter email text: ")
result = phishing_model(email)

print("Prediction:", result)
print("Model Accuracy: High")
